# Same Supabase project as ABOS — copy these from ABOS's Vercel env vars
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Comma-separated list of emails allowed to log in as the store/owner
# (sees ALL conversations, not just their own)
VITE_OWNER_EMAILS=owner@example.com

# --- Server-side only (used by /api/groq-reply.js — do NOT prefix with VITE_) ---
# Same Groq key ABOS already uses.
GROQ_API_KEY=your-groq-key
# Supabase → Settings → API → "service_role" key (NOT the anon key).
# Needed to insert AI replies bypassing RLS. Keep this secret — set it
# only in Vercel's environment variables, never commit it or expose it
# to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Shared secret that authenticates calls to /api/groq-reply. As of
# Phase 1, this endpoint is called by a Postgres trigger (via pg_net),
# not by the browser — this secret is how it proves the call really
# came from our own database.
AI_REPLY_WEBHOOK_SECRET=generate-a-long-random-string

# --- Sentry (error monitoring) ---
# Frontend DSN — safe to ship in the browser bundle, it's a write-only
# ingest endpoint, not a secret. From sentry.io → Project Settings → Client Keys.
VITE_SENTRY_DSN=https://xxxx@xxxx.ingest.sentry.io/xxxx
# Same DSN, read server-side by api/_lib/sentryServer.js (Phase 4.6).
# Can be the same value as VITE_SENTRY_DSN above — kept separate so a
# different (e.g. backend-only) Sentry project can be swapped in later
# without touching the frontend one.
SENTRY_DSN=https://xxxx@xxxx.ingest.sentry.io/xxxx

# --- LiveKit (Phase 4.6: AI voice calling) ---
# From cloud.livekit.io → your project → Settings → Keys. Free "Build"
# tier: 5,000 WebRTC minutes + 1,000 AI Agent minutes / month, no card needed.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# --- Azure Speech (Phase 4.6: Urdu + English TTS for the AI agent) ---
# NOT used by this Vercel app directly — these live on the separate
# abos-chat-ai-agent worker (deployed to LiveKit Cloud), listed here so
# every secret this feature needs is documented in one place.
# Free F0 tier: 500,000 characters/month, forever, no card needed.
# From portal.azure.com → your Speech resource → Keys and Endpoint.
AZURE_SPEECH_KEY=your-azure-speech-key
AZURE_SPEECH_REGION=your-azure-region
